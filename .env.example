APP_NAME=Dovi AI Server
DEBUG=false
LOG_LEVEL=INFO

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_REVIEW_REQUEST_TOPIC=pr.review.requested
KAFKA_REVIEW_COMPLETED_TOPIC=pr.review.completed
KAFKA_REVIEW_FAILED_TOPIC=pr.review.failed
KAFKA_COMMENT_ANSWER_REQUEST_TOPIC=pr.comment.answer.requested
KAFKA_COMMENT_ANSWER_COMPLETED_TOPIC=pr.comment.answer.completed
KAFKA_COMMENT_ANSWER_FAILED_TOPIC=pr.comment.answer.failed
# 운영 배포 시 true로 설정 — 앱이 실제로 Kafka consumer를 기동한다
KAFKA_CONSUMER_ENABLED=false
# 종료 신호를 받았을 때 처리 중인 리뷰를 강제 취소하기 전에 기다려주는 최대 시간(초)
GRACEFUL_SHUTDOWN_SECONDS=130

# LLM_PROFILE: single_gpu_16gb | dual_gpu_32gb
LLM_PROFILE=dual_gpu_32gb
LLM_BASE_URL=http://localhost:8001/v1
LLM_MODEL=qwen2.5-coder-32b-instruct-q4_k_m.gguf
LLM_MAX_CONTEXT=8192
LLM_GPU_LAYERS=-1
LLM_TIMEOUT_SECONDS=120

REDIS_URL=redis://localhost:6379
REVIEW_DEDUP_TTL_SECONDS=86400
COMMENT_ANSWER_DEDUP_TTL_SECONDS=3600

# scripts/index_repo.py로 인덱싱을 마친 뒤에만 true로 설정
RAG_ENABLED=false
QDRANT_URL=http://localhost:6333
RAG_COLLECTION_NAME=dovi_code_chunks
EMBEDDING_MODEL=nomic-ai/CodeRankEmbed
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# push 시점 증분 재인덱싱 요청(github-app 발행). RAG_ENABLED와 함께 게이팅된다.
KAFKA_REPO_INDEX_REQUEST_TOPIC=repo.index.requested

# DOVI.md에 Notion API 명세 DB 링크가 등록된 레포에서만 true로 설정
NOTION_SYNC_ENABLED=false
NOTION_API_TOKEN=
API_SPEC_COLLECTION_NAME=dovi_api_spec_chunks

# Alembic 마이그레이션(alembic/) 적용 후에만 true로 설정
EVALUATION_ENABLED=false
# Postgres는 ai vm에 함께 띄우지 않는다 — kafka/redis와 같은 별도 mq vm에서
# 운영한다(사설망 IP로 접속). 운영 값은 .env(gitignore 대상)에만 실제 값을 넣는다.
DATABASE_URL=postgresql+asyncpg://dovi:CHANGE_ME@10.0.0.82:5432/dovi
KAFKA_REVIEW_FEEDBACK_TOPIC=pr.comment.reflected
OFFICIAL_DOCS_WORKFLOW_ENABLED=false

# docker-compose.yml의 langfuse-* 서비스를 띄운 뒤 true로 설정. LLM 호출 트레이싱용.
LANGFUSE_ENABLED=false
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY/SECRET_KEY와 동일한 값을 넣는다(아래 참고)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse-web:3000

# --- Langfuse self-hosted 스택 전용 (docker-compose.yml langfuse-* 서비스) ---
# 전부 실제 배포 시 무작위 값으로 채운다 — 기본값 그대로 쓰지 않는다.
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_MINIO_ROOT_PASSWORD=
LANGFUSE_REDIS_AUTH=
# 최초 기동 시 자동 생성될 조직/프로젝트의 로그인 계정 + API 키 (LANGFUSE_PUBLIC_KEY/
# SECRET_KEY와 같은 값을 위 LANGFUSE_INIT_PROJECT_PUBLIC_KEY/SECRET_KEY에 그대로 사용)
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=dovi-admin
LANGFUSE_INIT_USER_PASSWORD=
# 미설정이어도 동작하지만(미인증 60회/시간), 프로덕션에서는 설정 권장 —
# 소진 시 해당 시간 동안 근거 수집이 일시 중단되고 경고 로그가 남는다(캐시 오염 없음)
GITHUB_TOKEN=
