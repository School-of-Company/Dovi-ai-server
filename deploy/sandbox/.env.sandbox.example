# 샌드박스 프로브 전용 VM의 ~/Dovi-ai-server/.env 예시. 실제 값은 VM에서만 채운다.
KAFKA_CONSUMER_ENABLED=true
# 이 VM은 GPU/llama-server가 없으므로 기존 컨슈머 그룹에 합류하지 않게 반드시 끈다.
REVIEW_CONSUMER_ENABLED=false
COMMENT_ANSWER_CONSUMER_ENABLED=false
SANDBOX_PROBE_CONSUMER_ENABLED=true

KAFKA_BOOTSTRAP_SERVERS=
REDIS_URL=

GITHUB_APP_INTERNAL_URL=
GITHUB_APP_INTERNAL_SECRET=

SANDBOX_PROBE_WORKDIR=/var/lib/dovi-sandbox
SANDBOX_PROBE_CONCURRENCY=4
SANDBOX_PROBE_JOB_TIMEOUT_SECONDS=900

# 배포 중 진행 중인 잡은 취소되고(리소스는 다음 기동 때 정리) 짧게 기다렸다 종료한다.
GRACEFUL_SHUTDOWN_SECONDS=60
LOG_LEVEL=INFO
